function calculateNextDueDate(task, completedAt, previousDue) { var base=task.Recurrence_Basis==='Schedule'&&previousDue?new Date(previousDue):new Date(completedAt||task.First_Due_Date); var n=task.Frequency==='Daily'?1:parseInt(task.Frequency,10); var d=new Date(base); d.setDate(d.getDate()+n); if(task.Frequency==='Daily') while(!isWorkingDay_(d)) d.setDate(d.getDate()+1); return d; }
function isWorkingDay_(d){var days=String(getConfig_('Working Days')).split(',').map(Number), holiday=Utilities.formatDate(d,tz_(),'yyyy-MM-dd'), hs=String(getConfig_('Holiday Dates')).split(','); return days.indexOf(d.getDay())>=0 && hs.indexOf(holiday)<0;}
function createTaskCycles(){var lock=LockService.getScriptLock(); lock.waitLock(30000); try{var tasks=rows_(ALLO.SHEETS.TASKS); tasks.forEach(function(t){if(String(t.Active_Status)!=='Active')return; var cycles=rows_(ALLO.SHEETS.PENDING).filter(function(c){return c.Task_ID===t.Task_ID;}); var open=cycles.filter(function(c){return c.Current_Status!=='Completed';}); if(open.length)return; var due=t.Next_Due_Date||t.First_Due_Date; if(!due)return; if(t.Frequency==='Daily'&&!isWorkingDay_(new Date(due)))return; var num=cycles.length+1, id=t.Task_ID+'-C'+('000'+num).slice(-3); appendObject_(ALLO.SHEETS.PENDING,{Cycle_ID:id,Task_ID:t.Task_ID,Task_Name:t.Task_Name,Assigned_Employee:t.Assigned_Employee,Employee_Email:t.Employee_Email,Cycle_Number:num,Due_Date:new Date(due),Due_Time:t.Due_Time||getConfig_('Default Due Time'),Current_Status:'Pending',Validation_Status:'Not Submitted'});}); } finally{lock.releaseLock();} return rows_(ALLO.SHEETS.PENDING);}
function generateDailyTasks(){return createTaskCycles();}
function preventDuplicateCycles(){var a=rows_(ALLO.SHEETS.PENDING), seen={}; return a.filter(function(c){var k=c.Task_ID+'|'+c.Cycle_Number;if(seen[k])return false;seen[k]=true;return true;}).length===a.length;}
function updateRecurringSchedule(task, completionTime, previousDue){var s=getSheet_(ALLO.SHEETS.TASKS), data=s.getRange(2,1,Math.max(1,s.getLastRow()-1),ALLO.HEADERS.Task_Master.length).getValues(), idx=col_(ALLO.HEADERS.Task_Master,'Task_ID'); for(var i=0;i<data.length;i++)if(data[i][idx]===task.Task_ID){data[i][col_(ALLO.HEADERS.Task_Master,'Last_Completed_Date')]=completionTime;data[i][col_(ALLO.HEADERS.Task_Master,'Next_Due_Date')]=calculateNextDueDate(task,completionTime,previousDue);s.getRange(i+2,1,1,data[i].length).setValues([data[i]]);return;}}
