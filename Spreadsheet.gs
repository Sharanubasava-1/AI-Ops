function initializeSystem() {
  var ss=SpreadsheetApp.getActive(), names=Object.keys(ALLO.SHEETS);
  names.forEach(function(k){var n=ALLO.SHEETS[k],s=ss.getSheetByName(n)||ss.insertSheet(n); if (s.getLastRow()===0 && ALLO.HEADERS[n]) s.appendRow(ALLO.HEADERS[n]);});
  setupConfiguration_(); setupDashboard_(); setupValidation_(); createInitialTasks(); installTimeTriggers(); audit_('INITIALIZE','System initialized');
  SpreadsheetApp.getUi().alert('ALLO AI Operations Manager initialized. Configure recipients before enabling email notifications.');
}
function setupConfiguration_(){var s=getSheet_(ALLO.SHEETS.CONFIG); if(s.getLastRow()===0)s.appendRow(['Setting','Value','Description']); var existing=rowsConfig_(); Object.keys(ALLO.DEFAULTS).forEach(function(k){if(existing.indexOf(k)<0)s.appendRow([k,ALLO.DEFAULTS[k],'Administrator setting']);});}
function rowsConfig_(){var s=getSheet_(ALLO.SHEETS.CONFIG); if(s.getLastRow()<2)return []; return s.getRange(2,1,s.getLastRow()-1,1).getValues().map(function(r){return r[0];});}
function setupDashboard_(){var s=getSheet_(ALLO.SHEETS.DASHBOARD); s.clear(); s.getRange('A1:B1').setValues([['ALLO AI OPERATIONS MANAGER','Live values from operational records']]); s.getRange(3,1,8,2).setValues([['Metric','Value'],['Total Active Tasks','=COUNTIF(Task_Master!L2:L,"Active")'],['Total Completed Tasks','=COUNTIF(Employee_Pending_Report!I2:I,"Completed")'],['Total Pending Tasks','=COUNTIF(Employee_Pending_Report!I2:I,"Pending")'],['Total Overdue Tasks','=COUNTIF(Employee_Pending_Report!I2:I,"Overdue")'],['Tasks Due Today','=COUNTIF(Employee_Pending_Report!G2:G,TODAY())'],['Tasks Awaiting Manager Acknowledgement','=COUNTIF(Escalation_Log!M2:M,"Pending")'],['Escalated Tasks','=COUNTIF(Escalation_Log!R2:R,"Sent")']]); s.getRange('A14:F14').setValues([['Employee Name','Assigned Tasks','Completed Tasks','Pending Tasks','Overdue Tasks','Completion Rate']]); s.setFrozenRows(1); s.autoResizeColumns(1,6);}
function setupValidation_(){var s=getSheet_(ALLO.SHEETS.PENDING); if(s.getLastRow()>1){var status=s.getRange(2,9,s.getMaxRows()-1,1); status.setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['Pending','Completed'],true).setAllowInvalid(false).build());} Object.keys(ALLO.SHEETS).forEach(function(k){var sh=getSheet_(ALLO.SHEETS[k]); sh.setFrozenRows(1); sh.getRange(1,1,1,sh.getLastColumn()).setFontWeight('bold').setBackground('#0b1f3a').setFontColor('#ffffff');});}
function createInitialTasks(){var s=getSheet_(ALLO.SHEETS.TASKS); if(s.getLastRow()>1)return; var d=new Date(); var tasks=[['TASK-001','Daily Operations Update','Post the daily operational update in the designated WhatsApp group.','Employee A','','Daily','Schedule',d,'17:00','Confirmation and update reference','','Active',d,'System','',''],['TASK-002','Portal Task A','Create or update the portal ticket.','Employee B','','7 days','Completion',d,'17:00','Ticket ID','','Active',d,'System','',''],['TASK-003','Portal Task B','Create or update the portal ticket.','Employee C','','15 days','Completion',d,'17:00','Ticket ID','','Active',d,'System','',''],['TASK-004','Portal Task C','Create or update the portal ticket.','Employee D','','30 days','Completion',d,'17:00','Ticket ID','','Active',d,'System','','']]; s.getRange(2,1,tasks.length,tasks[0].length).setValues(tasks); audit_('SAMPLE_DATA','Created four clearly labelled sample tasks');}
function showConfiguration(){SpreadsheetApp.getUi().alert('Edit the Configuration sheet. Email notifications remain disabled until recipients and Email Notification Enabled=TRUE are configured.');}
