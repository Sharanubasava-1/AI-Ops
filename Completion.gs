function getEmployeeTasks(){var email=Session.getActiveUser().getEmail(); return rows_(ALLO.SHEETS.PENDING).filter(function(c){return !email||c.Employee_Email===email;});}
function validateCompletion(c){var proof=String(c.Required_Proof_Type||''); if(proof.indexOf('Ticket')>=0&&!String(c.Ticket_ID||'').trim())return {valid:false,error:'Ticket ID is required.'}; if(proof.indexOf('Confirmation')>=0&&!String(c.WhatsApp_Update_Reference||'').trim())return {valid:false,error:'WhatsApp update reference is required.'}; return {valid:true};}
function submitTaskCompletion(cycleId, values){var lock=LockService.getScriptLock();lock.waitLock(30000);try{var s=getSheet_(ALLO.SHEETS.PENDING), data=s.getRange(2,1,Math.max(1,s.getLastRow()-1),ALLO.HEADERS.Employee_Pending_Report.length).getValues(), h=ALLO.HEADERS.Employee_Pending_Report, ix=col_(h,'Cycle_ID'), row=-1; for(var i=0;i<data.length;i++)if(data[i][ix]===cycleId){row=i;break;} if(row<0)throw new Error('Cycle not found.'); var c=rowObject_(h,data[row]); var email=Session.getActiveUser().getEmail(); if(email&&c.Employee_Email&&email!==c.Employee_Email)throw new Error('You are not authorized for this employee task.'); Object.keys(values||{}).forEach(function(k){if(h.indexOf(k)>=0)data[row][h.indexOf(k)]=values[k];}); c=rowObject_(h,data[row]); var check=validateCompletion(c);if(!check.valid)throw new Error(check.error); if(c.Current_Status==='Completed')return c; var stamp=now_(); data[row][col_(h,'Current_Status')]='Completed';data[row][col_(h,'Submitted_By')]=email||'Unverified user';data[row][col_(h,'Completion_Timestamp')]=stamp;data[row][col_(h,'Validation_Status')]='Valid';s.getRange(row+2,1,1,data[row].length).setValues([data[row]]); var task=rows_(ALLO.SHEETS.TASKS).filter(function(t){return t.Task_ID===c.Task_ID;})[0]; if(!rows_(ALLO.SHEETS.COMPLETIONS).some(function(x){return x.Cycle_ID===cycleId;}))appendObject_(ALLO.SHEETS.COMPLETIONS,{Completion_ID:'COMP-'+Utilities.getUuid(),Cycle_ID:cycleId,Task_ID:c.Task_ID,Task_Name:c.Task_Name,Employee_Name:c.Assigned_Employee,Employee_Email:c.Employee_Email,Cycle_Number:c.Cycle_Number,Completion_Date:stamp,Completion_Timestamp:stamp,Ticket_ID:c.Ticket_ID,Completion_Notes:c.Completion_Notes,Proof_Reference:c.WhatsApp_Update_Reference||c.Proof_Link,Validation_Result:'Valid',Recorded_Timestamp:stamp}); updateRecurringSchedule(task,stamp,c.Due_Date); resolveEscalations_(cycleId); audit_('COMPLETE',cycleId); return rowObject_(h,data[row]);}finally{lock.releaseLock();}}
function preventDuplicateCompletions(){var a=rows_(ALLO.SHEETS.COMPLETIONS),seen={};return a.every(function(x){if(seen[x.Cycle_ID])return false;seen[x.Cycle_ID]=true;return true;});}
function resolveEscalations_(cycleId){var s=getSheet_(ALLO.SHEETS.ESCALATIONS),h=ALLO.HEADERS.Escalation_Log;if(s.getLastRow()<2)return;var d=s.getRange(2,1,s.getLastRow()-1,h.length).getValues();d.forEach(function(r,i){if(r[col_(h,'Cycle_ID')]===cycleId){r[col_(h,'Resolution_Status')]='Resolved';r[col_(h,'Resolution_Timestamp')]=now_();s.getRange(i+2,1,1,r.length).setValues([r]);}});}
