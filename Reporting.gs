function generateManagerDashboard(){setupDashboard_();var s=getSheet_(ALLO.SHEETS.DASHBOARD), employees={};rows_(ALLO.SHEETS.PENDING).forEach(function(c){var e=c.Assigned_Employee;employees[e]=employees[e]||{a:0,done:0,p:0,o:0};employees[e].a++;if(c.Current_Status==='Completed')employees[e].done++;if(c.Current_Status==='Overdue')employees[e].o++;if(c.Current_Status==='Pending')employees[e].p++;});Object.keys(employees).forEach(function(e){var x=employees[e];s.appendRow([e,x.a,x.done,x.p,x.o,x.a?x.done/x.a:0]);});}
function runDailyAutomation(){createTaskCycles();checkPendingTasks();checkManagerAcknowledgement();checkLeadershipEscalation();generateManagerDashboard();}
