function recordTest_(id,name,expected,actual,pass,evidence,remarks){appendObject_(ALLO.SHEETS.TESTS,{Test_ID:id,Test_Name:name,Execution_Date:now_(),Expected_Result:expected,Actual_Result:actual,'Pass / Fail':pass?'PASS':'FAIL',Evidence_Reference:evidence,Remarks:remarks});}
function runDuplicatePreventionTest(){var pass=preventDuplicateCycles()&&preventDuplicateCompletions()&&preventDuplicateAlerts();recordTest_('TEST-08','Duplicate prevention','No duplicate cycles, completions, alerts or triggers',pass?'All duplicate checks passed':'One or more duplicate checks failed',pass,'Function return values','Trigger count is checked by diagnostics.');}
function sendTestManagerAlert(){var p=rows_(ALLO.SHEETS.PENDING)[0];if(!p)throw new Error('Create cycles first.');var result=sendManagerAlert_(p), pass=result.Email_Send_Status==='Sent'||result.Email_Send_Status==='Test mode - not sent';recordTest_('TEST-04','Same-day manager alert','A manager alert attempt is logged without false sent status',result.Email_Send_Status,pass,'Escalation_Log','PASS means the outcome was truthfully logged; real delivery requires configured recipient and enabled notifications.');}
function runManagerAcknowledgementTest(){var p=rows_(ALLO.SHEETS.PENDING)[0];if(!p)throw new Error('Create cycles first.');acknowledgeManagerAlert(p.Cycle_ID,'Test acknowledgement');var found=rows_(ALLO.SHEETS.ESCALATIONS).some(function(e){return e.Cycle_ID===p.Cycle_ID&&e.Manager_Acknowledgement_Status==='Acknowledged';});recordTest_('TEST-05','Manager acknowledgement','Acknowledgement is stored separately from completion',found?'Acknowledgement recorded':'No manager alert row found',found,'Escalation_Log','');}
function runLeadershipEscalationTest(){var before=rows_(ALLO.SHEETS.ESCALATIONS).length;checkLeadershipEscalation();var after=rows_(ALLO.SHEETS.ESCALATIONS).length;recordTest_('TEST-06','Leadership escalation','Due escalation conditions create an independently tracked event',after>before?'Escalation event recorded':'No due escalation condition was present',after>before,'Escalation_Log','Use shortened SLAs and a test overdue cycle.');}
function runSystemDiagnostics(){var result={sheets:Object.keys(ALLO.SHEETS).every(function(k){return !!SpreadsheetApp.getActive().getSheetByName(ALLO.SHEETS[k]);}),triggers:ScriptApp.getProjectTriggers().length,identity:Session.getActiveUser().getEmail()||'Unavailable',emailEnabled:configBool_('Email Notification Enabled')};Logger.log(JSON.stringify(result));SpreadsheetApp.getUi().alert(JSON.stringify(result,null,2));return result;}
function runAllTests(){runDuplicatePreventionTest();sendTestManagerAlert();runManagerAcknowledgementTest();runLeadershipEscalationTest();}
