function checkPendingTasks(){var s=getSheet_(ALLO.SHEETS.PENDING),h=ALLO.HEADERS.Employee_Pending_Report,d=s.getLastRow()<2?[]:s.getRange(2,1,s.getLastRow()-1,h.length).getValues();d.forEach(function(r,i){var c=rowObject_(h,r);if(c.Current_Status==='Completed')return;var due=new Date(c.Due_Date),parts=String(c.Due_Time||'17:00').split(':');due.setHours(Number(parts[0]),Number(parts[1]||0),0,0);if(now_().getTime()>due.getTime()){r[col_(h,'Current_Status')]='Overdue';s.getRange(i+2,1,1,r.length).setValues([r]);}if(now_().getTime()>due.getTime()+Number(getConfig_('Manager Alert Grace Period'))*60000)sendManagerAlert_(rowObject_(h,r));});}
function sendManagerAlerts(){checkPendingTasks();}
function sendManagerAlert_(c){var task=rows_(ALLO.SHEETS.TASKS).filter(function(t){return t.Task_ID===c.Task_ID;})[0], e=rows_(ALLO.SHEETS.ESCALATIONS).filter(function(x){return x.Cycle_ID===c.Cycle_ID&&x.Alert_Stage==='Manager';})[0];if(e&&e.Email_Send_Status==='Sent')return e;var x={Escalation_ID:'ESC-'+Utilities.getUuid(),Cycle_ID:c.Cycle_ID,Task_ID:c.Task_ID,Employee_Name:c.Assigned_Employee,Employee_Email:c.Employee_Email,Manager_Email:task.Manager_Email||getConfig_('Manager Email'),Alert_Stage:'Manager',Alert_Type:'Overdue task',Alert_Created_Timestamp:now_(),Email_Send_Status:'Pending',Manager_Acknowledgement_Status:'Pending',Leadership_Email:getConfig_('Leadership Email'),Resolution_Status:'Open'};if(!configBool_('Email Notification Enabled')){x.Email_Send_Status='Test mode - not sent';appendObject_(ALLO.SHEETS.ESCALATIONS,x);return x;}try{var to=x.Manager_Email||getConfig_('Test Email Override');if(!to)throw new Error('Manager email is not configured.');MailApp.sendEmail({to:to,subject:'Action Required – Overdue Task: '+c.Task_Name,htmlBody:managerEmail_(c,task)});x.Email_Send_Status='Sent';x.Email_Sent_Timestamp=now_();}catch(err){x.Email_Send_Status='Failed';x.Email_Error=String(err);}appendObject_(ALLO.SHEETS.ESCALATIONS,x);return x;}
function managerEmail_(c,t){return '<p>Employee: '+c.Assigned_Employee+' ('+c.Employee_Email+')</p><p>Task: '+c.Task_Name+' ['+c.Task_ID+']<br>Cycle: '+c.Cycle_ID+'<br>Original due date: '+c.Due_Date+' at '+c.Due_Time+'<br>Required proof: '+t.Required_Proof_Type+'<br>Status: '+c.Current_Status+'</p><p>Acknowledge in Manager_Dashboard or the ALLO sidebar.</p>';}
function acknowledgeManagerAlert(cycleId,comments){var email=Session.getActiveUser().getEmail(), manager=getConfig_('Manager Email');if(manager&&email&&email!==manager)throw new Error('Only the configured manager may acknowledge alerts.');var s=getSheet_(ALLO.SHEETS.ESCALATIONS),h=ALLO.HEADERS.Escalation_Log,d=s.getRange(2,1,Math.max(1,s.getLastRow()-1),h.length).getValues();d.forEach(function(r,i){if(r[col_(h,'Cycle_ID')]===cycleId&&r[col_(h,'Alert_Stage')]==='Manager'){r[col_(h,'Manager_Acknowledgement_Status')]='Acknowledged';r[col_(h,'Acknowledged_By')]=email||'Unverified manager';r[col_(h,'Acknowledgement_Timestamp')]=now_();r[col_(h,'Manager_Comments')]=comments||'';s.getRange(i+2,1,1,r.length).setValues([r]);}});audit_('ACKNOWLEDGE',cycleId);}
function checkManagerAcknowledgement(){rows_(ALLO.SHEETS.ESCALATIONS).forEach(function(e){if(e.Alert_Stage==='Manager'&&e.Manager_Acknowledgement_Status==='Pending'&&minutesSince_(e.Alert_Created_Timestamp)>=Number(getConfig_('Manager Acknowledgement SLA')))sendLeadershipEscalation_(e,'Missing manager acknowledgement');});}
function checkLeadershipEscalation(){rows_(ALLO.SHEETS.ESCALATIONS).forEach(function(e){if(e.Alert_Stage==='Manager'&&e.Resolution_Status!=='Resolved'&&minutesSince_(e.Alert_Created_Timestamp)>=Number(getConfig_('Leadership Escalation SLA')))sendLeadershipEscalation_(e,'Unresolved task');});}
function sendLeadershipEscalation(){checkLeadershipEscalation();checkManagerAcknowledgement();}
function sendLeadershipEscalation_(e,type){if(rows_(ALLO.SHEETS.ESCALATIONS).some(function(x){return x.Cycle_ID===e.Cycle_ID&&x.Alert_Stage==='Leadership'&&x.Alert_Type===type&&x.Email_Send_Status==='Sent';}))return;var x={Escalation_ID:'ESC-'+Utilities.getUuid(),Cycle_ID:e.Cycle_ID,Task_ID:e.Task_ID,Employee_Name:e.Employee_Name,Employee_Email:e.Employee_Email,Manager_Email:e.Manager_Email,Alert_Stage:'Leadership',Alert_Type:type,Alert_Created_Timestamp:now_(),Email_Send_Status:'Pending',Manager_Acknowledgement_Status:e.Manager_Acknowledgement_Status,Manager_Comments:e.Manager_Comments,Leadership_Email:e.Leadership_Email,Leadership_Escalation_Status:'Pending',Resolution_Status:e.Resolution_Status};if(!configBool_('Email Notification Enabled')){x.Email_Send_Status='Test mode - not sent';appendObject_(ALLO.SHEETS.ESCALATIONS,x);return;}try{if(!x.Leadership_Email)throw new Error('Leadership email is not configured.');MailApp.sendEmail(x.Leadership_Email,'Leadership Escalation: '+e.Task_ID,'Cycle '+e.Cycle_ID+' remains unresolved. Alert type: '+type);x.Email_Send_Status='Sent';x.Email_Sent_Timestamp=now_();x.Leadership_Escalation_Status='Sent';}catch(err){x.Email_Send_Status='Failed';x.Email_Error=String(err);}appendObject_(ALLO.SHEETS.ESCALATIONS,x);}
function preventDuplicateAlerts(){var a=rows_(ALLO.SHEETS.ESCALATIONS),seen={};return a.every(function(x){var k=x.Cycle_ID+'|'+x.Alert_Stage+'|'+x.Alert_Type;if(seen[k]&&x.Email_Send_Status==='Sent')return false;seen[k]=true;return true;});}
function minutesSince_(d){return d?((now_().getTime()-new Date(d).getTime())/60000):0;}
